# --- 核心隐私数据 (必须排除！) ---
edge_profile_data/
edge_automation_profile/
edge_profile/
# 排除配置文件（包含你的发布标题、话题等私密偏好）
config.json

# --- 打包产物与缓存 ---
dist/
build/
*.spec
__pycache__/
*.pyc

# --- 媒体文件 (防止误上传测试图片) ---
# 如果你的项目目录下有用于测试的发布图片，建议排除
*.jpg
*.jpeg
*.png
# 但要保留图标，所以我们可以加上这一行例外：
!app.ico

# --- 运行时日志 ---
*.log
xiaohongshu_edge_error.log

# --- 开发环境与工具 ---
.vscode/
.idea/
.pixi/
pixi.lock
venv/
.venv/

# --- 系统文件 ---
.DS_Store
Thumbs.db